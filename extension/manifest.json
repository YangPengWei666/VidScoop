{
  "manifest_version": 3,
  "name": "音频转文字",
  "version": "0.1.0",
  "description": "把视频里的声音转成文字，自动整理摘要，存成 Markdown 笔记",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.youtube.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon-obsidian.png",
        "icon-bright.png",
        "icon-gray.png"
      ],
      "matches": [
        "https://www.bilibili.com/*",
        "https://bilibili.com/*",
        "https://www.youtube.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://bilibili.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "floating-button.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "音频转文字",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
