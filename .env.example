# VidScoop 配置模板
# 用法：把这个文件复制一份，改名为 .env（注意前面有个点），然后填下面的值
# .env 已被 .gitignore 忽略，不会上传到 GitHub

# ===== 必填项 =====

# Groq 的 API Key（免费申请，申请方法见 README）
GROQ_API_KEY=

# 硅基流动的 API Key（免费申请，申请方法见 README）
SILICONFLOW_API_KEY=

# 笔记保存路径：笔记会写进「这个目录/00-Clip/」下
# 用 Obsidian 就填你的库根目录；不用 Obsidian 也行，随便找个文件夹
# Windows 路径请用正斜杠，例如 D:/我的笔记
VAULT_DIR=

# ===== 选填项（不填也能跑）=====

# 智谱 API Key（免费的 glm-4-flash，作为备用渠道）
# ZHIPU_API_KEY=

# 第二个 Groq 账号，自动轮换，额度翻倍
# GROQ_API_KEY_2=

# ---------- 以下一般不用改 ----------

# GROQ_LLM_MODEL=openai/gpt-oss-120b
# SILICONFLOW_LLM_MODEL=THUDM/GLM-4-9B-0414
# ZHIPU_LLM_MODEL=glm-4-flash
# POLISH_ENABLED=true
# GRAB_COMMENTS=true
# COMMENTS_TOP_N=5
# POLISH_CHUNK_CHARS=2800
# MAX_AUDIO_MB=200
# DOWNLOAD_TIMEOUT=600
