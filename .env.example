# VidScoop 配置模板 —— 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会进仓库）

# ===== 必填：API Key（获取方法见 README）=====
GROQ_API_KEY=
SILICONF…KEY=
ZHIPU_API_KEY=
***

# ===== 必填：笔记保存路径 =====
# 笔记会写进「该目录/00-Clip/」；用 Obsidian 就指向你的库根目录，不用也行
VAULT_DIR=D:/MyNotes

# ===== 可选：高级项（默认值即可跑）=====
# GROQ_API_KEY_2=            # 第二个 Groq 账号，自动轮换翻倍额度
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# SILICONFLOW_LLM_MODEL=THUDM/GLM-4-9B-0414
# ZHIPU_LLM_MODEL=glm-4-flash
# POLISH_ENABLED=true        # AI 整理逐字稿（加标点/分段/纠错）
# GRAB_COMMENTS=true         # B站高赞评论一并入库
# COMMENTS_TOP_N=5
# POLISH_CHUNK_CHARS=2800    # 整理分片字数（长视频调大=片少=快，注意模型输出上限）
# MAX_AUDIO_MB=200
# DOWNLOAD_TIMEOUT=600
